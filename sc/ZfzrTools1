  object MergeExtensionMapper {
    val apairs = """\s*if\s*\(\s*\"([^\"]+)\"[^\"]+\"([^\"]+)\"[^r]+return\s*([^;]+);""".r //

    import scala.collection.mutable.Map

    type KK = (String, String)
    type MM = Map[KK, String]

    def cmap(file: Path): MM = cmap(read(file))

    def cmap(text: String): MM = apairs.findAllMatchIn(text).foldLeft(Map[KK, String]())((map, m) => {
      map += (m.group(1), m.group(2)) -> m.group(3)
    })

    def mergeMaps(cmaps: Seq[MM]): MM = {
      def appFirst(kk: KK): Option[String] = {
        var these = cmaps
        while (!these.isEmpty) {
          if (these.head.contains(kk)) return Some(these.head(kk))
          these = these.tail
        }
        None
      }

      val keySet = cmaps.foldLeft[Set[KK]](Set.empty)((s0, mm) => s0 ++ mm.keySet)
      keySet.foldLeft[MM](Map[KK, String]())((map, kk) => {
        map += kk -> appFirst(kk).getOrElse("FEHLER: kein Wert für " + kk)
      })

    }

    def code4(p: ((String, String), String)) =
      s"""      if ("${p._1._1}".equals(namespaceURI) && "${p._1._2}".equals(typeName)) {
            return ${p._2};
        }
  """

    def toCode(cmap: Map[(String, String), String]) = {
      val buf = new StringBuffer
      cmap.foreach { kv => buf.append(code4(kv))
      }
      buf.toString()
    }

    def mergeFiles(files: Path*) = {
      val cmaps = files map cmap
      cmaps foreach { m => println("\n\n\n/nMap:" + m.toString() + "\n\n\n\n") }
      val map = mergeMaps(cmaps)
      toCode(map)
    }

    def apply(targetfile: Path, genfile1: String, genfile2: String): Unit = {
      apply(targetfile, Path(genfile1), Path(genfile2))
    }

    def apply(targetfile: Path, genfiles: Path*): Unit = {
      val code = mergeFiles(genfiles: _*)
      println("\n\n" + code)
      write(targetfile, code)

    }

  }

