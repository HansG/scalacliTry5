# .devcontainer/Dockerfile

# Startet von einem Standard-Ubuntu-Image, das gängige Tools enthält
FROM mcr.microsoft.com/devcontainers/base:ubuntu

# Als root-Benutzer ausführen für Installationen
USER root

# Java 17 (Voraussetzung für Scala 3) und weitere Tools installieren
RUN apt-get update && export DEBIAN_FRONTEND=noninteractive \
    && apt-get -y install --no-install-recommends openjdk-17-jdk curl unzip

# scala-cli über Coursier installieren
RUN curl -fL https://github.com/coursier/coursier/releases/latest/download/cs-x86_64-pc-linux.gz | gzip -d > /usr/local/bin/cs \
    && chmod +x /usr/local/bin/cs \
    && cs setup --yes --apps scala-cli,scala

# Fügt das Coursier-bin-Verzeichnis zum PATH hinzu
ENV PATH="/root/.local/share/coursier/bin:$PATH"

# Wechselt zurück zum Standard-non-root-Benutzer 'vscode'
USER vscode
